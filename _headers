# Cloudflare Pages 响应头
# 输出目录是仓库根目录，所以规则都要写全路径

# 收藏夹（根目录站点）
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/data.json
  Cache-Control: no-cache
  Content-Type: application/json; charset=utf-8

# 白嫖清单子站（/free-tokens/）
/free-tokens/
  Cache-Control: no-cache

/free-tokens/index.html
  Cache-Control: no-cache

/free-tokens/data.json
  Cache-Control: no-cache
  Content-Type: application/json; charset=utf-8

# 封面与图标：一天缓存，换图后最迟一天生效
/images/*
  Cache-Control: public, max-age=86400

/free-tokens/images/*
  Cache-Control: public, max-age=86400